<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <title>Sign Up</title>
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <style>
    body { font-family: system-ui, sans-serif; max-width: 460px; margin: 3rem auto; padding: 0 1rem; }
    form { display: grid; gap: 0.75rem; }
    label { display: grid; gap: 0.25rem; }
    input, button { padding: 0.6rem; font-size: 1rem; }
    .error { color: #b00020; }
    .info { color: #555; font-size: 0.9rem; }
  </style>
</head>
<body>
  <h1>Create an account</h1>

  <% if (typeof error !== 'undefined' && error) { %>
    <p class="error"><%= error %></p>
  <% } %>

  <form method="post" action="/sign-up" novalidate>
    <label>
      Name
      <input name="name" type="text" autocomplete="name" required />
    </label>

    <label>
      Email
      <input name="email" type="email" autocomplete="email" required />
    </label>

    <label>
      Password
      <input name="password" type="password" autocomplete="new-password" minlength="8" required />
    </label>

    <button type="submit">Sign Up</button>
    <p class="info">Already have an account? <a href="/log-in">Log in</a></p>
  </form>
</body>
</html>
