<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8" />
    <title>Log In</title>
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <style>
        body {
            font-family: system-ui, sans-serif;
            max-width: 460px;
            margin: 3rem auto;
            padding: 0 1rem;
        }
    </style>
</head>

<body>
    <a href="/dashboard">Go to Dashboard</a>

    <div>
        <!-- Folders -->
        <% result.folders.forEach(folder=> { %>
            <a href="/folder/<%= folder.id %>">
                <div
                    style="display: flex; align-items: center; gap: 1rem; border: 1px solid #ddd; padding: 0.5rem; border-radius: 6px; margin-bottom: 8px;">
                    <form action="/folder/<%= folder.id %>/delete" method="post"
                        onsubmit="return confirm('Do you want to delete this folder?');">
                        <button type="submit" style="margin-right: 1rem;">X</button>
                    </form>
                    <img src="/public/folder.svg" alt="Folder icon" style="width: 60px; height: auto;">
                    <h3 style="margin: 0;">
                        <%= folder.name %>
                    </h3>
                </div>
            </a>
            <% }); %>

                <!-- Files -->
                <% result.files.forEach(file=> { %>
                    <div
                        style="display: flex; align-items: center; gap: 1rem; border: 1px solid #ddd; padding: 0.5rem; border-radius: 6px; margin-bottom: 8px;">
                        <img src="/public/folder.svg" alt="File icon" style="width: 60px; height: auto;">
                        <h3 style="margin: 0;">
                            <%= file.name %>
                        </h3>
                    </div>
                    <% }); %>
    </div>


    <div>
        <h3>Add folder</h3>
        <form action="/folder/<%= id %>/create-folder" method="post">
            <input type="text" name="folderName" placeholder="Folder Name" required />
            <button type="submit">Create Folder</button>
        </form>
    </div>


    <form action="/folder/<%= id %>/upload-file" method="post" enctype="multipart/form-data">
        <input type="file" name="file" />
        <button type="submit">Upload File</button>
    </form>


</body>

</html>